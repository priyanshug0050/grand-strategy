# ============================================================================
#  Copy to .env and fill in. NEVER commit .env — add it to .gitignore first.
# ============================================================================

DATABASE_URL=postgresql://gameuser:CHANGE_ME@localhost:5432/gamedb

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Server refuses to start without this. Must be 32+ characters.
JWT_SECRET=

# Salt for hashing IPs/devices in the anti-multi-accounting table.
LINK_SALT=change-this-too

PORT=3000

# Must match the browser address bar EXACTLY — protocol + host + port.
# localhost and 127.0.0.1 are DIFFERENT origins to the browser.
# Restart the server after changing this.
# Leave unset — the server serves the frontend itself, so there is no
# cross-origin request and CORS does not apply. Only set this if you serve
# the frontend separately.
# CORS_ORIGIN=http://127.0.0.1:5500

# Turn length. Production is 7200000 (2 hours). 30000 = 30s for local testing.
TURN_INTERVAL_MS=30000

# Set true ONLY for local testing on a shared connection. Disables the
# same-machine war block. Never enable in production.
ALLOW_LINKED_WARS=false

# DANGER: wipes every table on boot. Only for the very first run.
# Set back to false IMMEDIATELY or every restart deletes all data.
RESET_DB=false
